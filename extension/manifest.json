{
  "manifest_version": 3,
  "name": "Fit Letter",
  "version": "0.1.0",
  "description": "Generate evidence-grounded cover letters from job postings.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}